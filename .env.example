# Django Secret Key (generate a secure random 50+ char string for production)
DN_SECRET_KEY=your_django_secret_key_here

# Debug Mode (set 0 or False for production, 1 or True for local development)
DN_DEBUG=1

# Allowed Hosts (comma-separated list)
DN_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Set DN_DB_ENGINE=sqlite to use local SQLite, or configure MySQL:
DN_DB_ENGINE=sqlite
DN_DB_NAME=drivenow_db
DN_DB_USER=root
DN_DB_PASSWORD=your_mysql_password_here
DN_DB_HOST=localhost
DN_DB_PORT=3306
